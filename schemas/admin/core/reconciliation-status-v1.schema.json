{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/admin/core/reconciliation-status-v1.schema.json",
  "title": "ReconciliationStatusV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "last_run_at", "total_discrepancies", "resolved_discrepancies", "counts_by_type"],
  "properties": {
    "state": {"type": "string", "minLength": 1, "maxLength": 32},
    "last_run_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "total_discrepancies": {"type": "integer", "minimum": 0},
    "resolved_discrepancies": {"type": "integer", "minimum": 0},
    "counts_by_type": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
