{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/admin/common/error-envelope-v1.schema.json",
  "title": "AdminErrorEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "code", "message", "request_id", "details"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "details": {"type": "object"}
  }
}
