{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/security/signing-intent-v1.schema.json",
  "title": "SigningIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "network_id", "request_id", "intent_id",
    "issuer_workload_id", "audience_workload_id", "caller_spiffe_id",
    "audience_spiffe_id", "issuer_roster_hash", "audience_roster_hash",
    "operation", "wallet_id", "bitcoin_network", "custody_bucket",
    "destination", "psbt_sha256", "change_descriptor_sha256", "policy_hash",
    "policy_epoch", "participant_epoch", "amount_sats", "max_fee_sats",
    "max_fee_rate_sat_vb", "expected_input_count", "commit_mode",
    "authorization_hash", "nonce", "sequence", "issued_at_epoch_ms",
    "expires_at_epoch_ms", "signature"
  ],
  "properties": {
    "contract_version": {"const": "0.3.0"},
    "network_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "intent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "issuer_workload_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audience_workload_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caller_spiffe_id": {"type": "string", "pattern": "^spiffe://[a-z0-9.-]+/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$", "maxLength": 512},
    "audience_spiffe_id": {"type": "string", "pattern": "^spiffe://[a-z0-9.-]+/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$", "maxLength": 512},
    "issuer_roster_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audience_roster_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"const": "sign_psbt"},
    "wallet_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "bitcoin_network": {"enum": ["mainnet", "testnet", "signet", "regtest"]},
    "custody_bucket": {"enum": ["users", "channels"]},
    "destination": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$"},
    "psbt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "participant_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "amount_sats": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "max_fee_sats": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "max_fee_rate_sat_vb": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "expected_input_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "commit_mode": {"enum": ["reserve_and_commit", "sign_reserved"]},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issued_at_epoch_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "expires_at_epoch_ms": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  }
}
