{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/discovery/membership-manifest-v1.schema.json",
  "title": "MembershipManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "network_id", "plane", "epoch", "phase", "previous_manifest_hash", "threshold", "members", "next_epoch", "signatures"],
  "properties": {
    "contract_version": {"const": "0.2.0"},
    "network_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plane": {"enum": ["bank", "vault"]},
    "epoch": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["stable", "joint"]},
    "previous_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "threshold": {"type": "integer", "minimum": 1, "maximum": 65535},
    "next_epoch": {"type": ["integer", "null"], "minimum": 1},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "root_public_key", "endpoint"],
        "properties": {
          "member_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "root_public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "endpoint": {"type": "string", "pattern": "^https://[a-z2-7]{56}\\.onion(?::[0-9]{1,5})?$"}
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "signature"],
        "properties": {
          "signer_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
        }
      }
    }
  }
}
