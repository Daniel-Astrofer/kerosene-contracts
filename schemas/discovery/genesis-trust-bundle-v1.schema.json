{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kerosene.invalid/discovery/genesis-trust-bundle-v1.schema.json",
  "title": "GenesisTrustBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "network_id", "bank", "vault", "created_at_epoch_ms"],
  "properties": {
    "contract_version": {"const": "0.2.0"},
    "network_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at_epoch_ms": {"type": "integer", "minimum": 0},
    "bank": {"$ref": "#/$defs/trustPlane"},
    "vault": {"$ref": "#/$defs/trustPlane"}
  },
  "$defs": {
    "trustPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "members"],
      "properties": {
        "threshold": {"type": "integer", "minimum": 1, "maximum": 65535},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member_id", "root_public_key"],
            "properties": {
              "member_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "root_public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
